# Optional: change the LiteLLM OpenAI-compatible proxy endpoint or route alias.
LITELLM_API_BASE=http://127.0.0.1:4000/v1
LITELLM_MODEL=gemini-3.8-flash-subscription

# LiteLLM virtual key with permission to call the route above.
LITELLM_API_KEY=replace-with-your-litellm-key

# VirusTotal key is read from the user's local secret file by default.
# Override only if you store it elsewhere.
# VT_API_KEY_FILE=/path/to/virustotal-api-key
